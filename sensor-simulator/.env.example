# ============================================================
# Sensor Simulator — Environment Configuration
# ============================================================

# --- MOCK MODE (default) ---
# Bundled standalone mock server. NOT the production backend.
BACKEND_URL=http://localhost:8001

# --- REAL INTEGRATION MODE ---
# Actual Spring Boot backend / services.
REAL_BACKEND_URL=http://localhost:8080
CV_SERVICE_URL=http://localhost:8000
ML_SERVICE_URL=http://127.0.0.1:9000

# Real-mode test image directory (place scenario images here)
# TEST_IMAGE_ROOT=./test-images

# API key (leave empty for open access)
API_KEY=

# --- Timing (seconds) ---
REQUEST_INTERVAL=2.0
STAGE_DELAY=3.0

# --- Simulation ---
DEFAULT_ZONE_ID=SLOPE_A
RANDOM_VARIATION=0.1

# --- Hysteresis (mock backend) ---
CRITICAL_READINGS_NEEDED=2

# --- Mock server ---
PORT=8001
RISK_HYSTERESIS_COUNT=2
